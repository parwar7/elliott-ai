# The application reads normal environment variables; it does not load this file automatically.
ELLIOTT_PROVIDER=packet
ELLIOTT_MODEL=
ELLIOTT_WORKSPACE=
ELLIOTT_DATABASE=
# Optional; false by default. Set true to add canonical Wilder RSI(14).
ELLIOTT_ENABLE_RSI=false

# OpenAI provider
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama provider
OLLAMA_BASE_URL=http://localhost:11434

# Private Telegram cloud bot. Store real values only in Railway Variables.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_POLL_TIMEOUT_SECONDS=30

# Set 0 to disable scheduled monitoring, or use 15 minutes or longer.
TELEGRAM_MONITOR_INTERVAL_MINUTES=0
TELEGRAM_MONITOR_BLIND=true

# Unified cloud OHLCV feed.
TWELVE_DATA_API_KEY=
ELLIOTT_CLOUD_TIMEFRAMES=monthly,weekly,daily,4h,1h,15m

# Railway volume paths. Docker supplies these defaults automatically.
ELLIOTT_CLOUD_DATA_ROOT=/data
ELLIOTT_SEED_DATABASE=/app/seed/elliott_ai.sqlite3
