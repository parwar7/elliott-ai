//@version=6
indicator("NFLX Fresh Blind Elliott Wave Map 2026-07-18", overlay=true, max_lines_count=300, max_labels_count=300)

showCycle = input.bool(true, "Cycle", group="Degrees")
showPrimary = input.bool(true, "Primary", group="Degrees")
showIntermediate = input.bool(true, "Intermediate", group="Degrees")
showMinor = input.bool(true, "Minor", group="Degrees")
showMinute = input.bool(true, "Minute", group="Degrees")
showLines = input.bool(true, "Wave paths", group="Display")
showLiveLevels = input.bool(true, "Live decision levels", group="Display")

displayCycle = showCycle
displayPrimary = showPrimary
displayIntermediate = showIntermediate and timeframe.in_seconds() <= timeframe.in_seconds("1W")
displayMinor = showMinor and timeframe.in_seconds() <= timeframe.in_seconds("1D")
displayMinute = showMinute and timeframe.in_seconds() <= timeframe.in_seconds("120")

cycleColor = color.rgb(235, 183, 52)
primary1Color = color.rgb(0, 166, 118)
primary2Color = color.rgb(224, 82, 82)
primary3Color = color.rgb(46, 134, 222)
primary4Color = color.rgb(241, 145, 36)
primary5Color = color.rgb(150, 94, 196)
intermediateColor = color.rgb(0, 178, 169)
minorColor = color.rgb(235, 90, 55)
minuteColor = color.rgb(62, 103, 207)

t(int y, int m, int d, int h=12, int min=0) => timestamp("UTC", y, m, d, h, min)

drawPath(array<int> times, array<float> prices, color pathColor, int width, string degreePrefix) =>
    if showLines
        for i = 1 to array.size(times) - 1
            line.new(array.get(times, i - 1), array.get(prices, i - 1), array.get(times, i), array.get(prices, i), xloc=xloc.bar_time, color=color.new(pathColor, 12), width=width)

drawPivot(int pivotTime, float pivotPrice, string labelText, color labelColor, bool above, int tier) =>
    float offset = 0.018 + tier * 0.014
    float y = above ? pivotPrice * (1 + offset) : pivotPrice * (1 - offset)
    label.new(pivotTime, y, labelText, xloc=xloc.bar_time, yloc=yloc.price, style=above ? label.style_label_down : label.style_label_up, color=labelColor, textcolor=color.white, size=tier >= 3 ? size.normal : size.small)

drawSequence(array<int> times, array<float> prices, array<string> names, color pathColor, int width, int tier) =>
    drawPath(times, prices, pathColor, width, "")
    for i = 0 to array.size(times) - 1
        bool above = i % 2 == 1
        drawPivot(array.get(times, i), array.get(prices, i), array.get(names, i), pathColor, above, tier)

var bool drawn = false
if barstate.islast and not drawn
    drawn := true

    if displayCycle
        array<int> ct = array.from(t(2002,10,7), t(2025,6,30), t(2026,7,17,13,30))
        array<float> cp = array.from(0.0346, 134.12, 65.08)
        drawPath(ct, cp, cycleColor, 4, "")
        drawPivot(t(2002,10,7), 0.0346, "Cycle I start", cycleColor, false, 4)
        drawPivot(t(2025,6,30), 134.12, "Cycle I", cycleColor, true, 4)
        drawPivot(t(2026,7,17,13,30), 65.08, "Cycle II?", cycleColor, false, 4)

    if displayPrimary
        array<int> pt = array.from(t(2002,10,7), t(2011,7,11), t(2012,7,30), t(2021,11,15), t(2022,5,9), t(2025,6,30))
        array<float> pp = array.from(0.0346, 4.35, 0.7544, 70.10, 16.27, 134.12)
        if showLines
            line.new(array.get(pt,0),array.get(pp,0),array.get(pt,1),array.get(pp,1),xloc=xloc.bar_time,color=primary1Color,width=3)
            line.new(array.get(pt,1),array.get(pp,1),array.get(pt,2),array.get(pp,2),xloc=xloc.bar_time,color=primary2Color,width=3)
            line.new(array.get(pt,2),array.get(pp,2),array.get(pt,3),array.get(pp,3),xloc=xloc.bar_time,color=primary3Color,width=3)
            line.new(array.get(pt,3),array.get(pp,3),array.get(pt,4),array.get(pp,4),xloc=xloc.bar_time,color=primary4Color,width=3)
            line.new(array.get(pt,4),array.get(pp,4),array.get(pt,5),array.get(pp,5),xloc=xloc.bar_time,color=primary5Color,width=3)
        drawPivot(array.get(pt,1),array.get(pp,1),"Primary I",primary1Color,true,3)
        drawPivot(array.get(pt,2),array.get(pp,2),"Primary II",primary2Color,false,3)
        drawPivot(array.get(pt,3),array.get(pp,3),"Primary III",primary3Color,true,3)
        drawPivot(array.get(pt,4),array.get(pp,4),"Primary IV",primary4Color,false,3)
        drawPivot(array.get(pt,5),array.get(pp,5),"Primary V",primary5Color,true,3)

        array<int> c2t = array.from(t(2025,6,30),t(2026,2,23),t(2026,4,16),t(2026,7,17,13,30))
        array<float> c2p = array.from(134.12,75.01,108.95,65.08)
        array<string> c2n = array.from("Cycle II start","Primary A","Primary B","Primary C?")
        drawSequence(c2t,c2p,c2n,primary2Color,3,3)

    if displayIntermediate
        array<int> p1t = array.from(t(2002,10,7),t(2004,1,26),t(2005,3,21),t(2010,6,14),t(2010,7,26),t(2011,7,11))
        array<float> p1p = array.from(0.0346,0.5681,0.1273,1.83,1.36,4.35)
        array<string> p1n = array.from("(0)","(1)","(2)","(3)","(4)","(5)")
        drawSequence(p1t,p1p,p1n,primary1Color,2,2)

        array<int> p3t = array.from(t(2012,7,30),t(2014,7,21),t(2015,1,5),t(2018,6,18),t(2019,9,23),t(2021,11,15))
        array<float> p3p = array.from(0.7544,6.54,4.57,42.32,25.23,70.10)
        array<string> p3n = array.from("(0)","(1)","(2)","(3)","(4)","(5)")
        drawSequence(p3t,p3p,p3n,primary3Color,2,2)

        array<int> p5t = array.from(t(2022,5,9),t(2023,7,17),t(2023,10,9),t(2025,2,10),t(2025,3,31),t(2025,6,30))
        array<float> p5p = array.from(16.27,48.50,35.21,106.45,85.39,134.12)
        array<string> p5n = array.from("(0)","(1)","(2)","(3)","(4)","(5)")
        drawSequence(p5t,p5p,p5n,primary5Color,2,2)

        array<int> at = array.from(t(2025,6,30),t(2025,8,5),t(2025,9,5),t(2025,11,21),t(2025,12,2),t(2026,2,23))
        array<float> ap = array.from(134.12,114.47,126.71,103.81,109.73,75.01)
        array<string> an = array.from("A(0)","A(1)","A(2)","A(3)","A(4)","A(5)")
        drawSequence(at,ap,an,primary2Color,2,2)

        array<int> bt = array.from(t(2026,2,23),t(2026,3,5),t(2026,3,20),t(2026,4,16))
        array<float> bp = array.from(75.01,100.19,90.69,108.95)
        array<string> bn = array.from("B(0)","B(a)","B(b)","B(c)")
        drawSequence(bt,bp,bn,intermediateColor,2,2)

        array<int> ict = array.from(t(2026,4,16),t(2026,4,28),t(2026,5,1),t(2026,6,25),t(2026,7,2),t(2026,7,17,13,30))
        array<float> icp = array.from(108.95,90.02,94.70,70.86,78.44,65.08)
        array<string> icn = array.from("C(0)","C(1)","C(2)","C(3)","C(4)","C(5)?")
        drawSequence(ict,icp,icn,primary2Color,2,2)

    if displayMinor
        array<int> m3t = array.from(t(2023,10,9),t(2024,4,1),t(2024,4,15),t(2024,12,2),t(2025,1,6),t(2025,2,10))
        array<float> m3p = array.from(35.21,63.80,55.22,93.53,83.44,106.45)
        array<string> m3n = array.from("1.3(0)","1.3.1","1.3.2","1.3.3","1.3.4","1.3.5")
        drawSequence(m3t,m3p,m3n,minorColor,1,1)

        array<int> m5t = array.from(t(2025,3,31),t(2025,4,9),t(2025,4,14),t(2025,6,2),t(2025,6,9),t(2025,6,30))
        array<float> m5p = array.from(85.39,95.14,91.95,126.28,118.06,134.12)
        array<string> m5n = array.from("1.5(0)","1.5.1","1.5.2","1.5.3","1.5.4","1.5.5")
        drawSequence(m5t,m5p,m5n,minorColor,1,1)

        array<int> c3t = array.from(t(2026,5,1),t(2026,5,11),t(2026,5,19),t(2026,6,12),t(2026,6,16),t(2026,6,25))
        array<float> c3p = array.from(94.70,85.10,91.48,79.28,81.93,70.86)
        array<string> c3n = array.from("C3(0)","C3.1","C3.2","C3.3","C3.4","C3.5")
        drawSequence(c3t,c3p,c3n,minorColor,1,1)

        array<int> c5t = array.from(t(2026,7,2),t(2026,7,6,18),t(2026,7,7,12),t(2026,7,10,16),t(2026,7,13,14),t(2026,7,17,13,30))
        array<float> c5p = array.from(78.44,75.72,78.18,72.52,75.44,65.08)
        array<string> c5n = array.from("C5(0)","C5.1","C5.2","C5.3","C5.4","C5.5?")
        drawSequence(c5t,c5p,c5n,minorColor,1,1)

    if displayMinute
        array<int> mt = array.from(t(2026,7,13,14),t(2026,7,14,13),t(2026,7,15,14),t(2026,7,16,21),t(2026,7,16,21,30),t(2026,7,17,13,30))
        array<float> mp = array.from(75.44,72.28,75.06,67.35,68.40,65.08)
        array<string> mn = array.from("i(0)","i","ii","iii","iv","v?")
        drawSequence(mt,mp,mn,minuteColor,1,0)

    if showLiveLevels
        line.new(t(2026,7,17),65.08,t(2027,1,1),65.08,xloc=xloc.bar_time,color=color.new(color.red,15),style=line.style_dashed,width=2)
        line.new(t(2026,7,17),69.49,t(2027,1,1),69.49,xloc=xloc.bar_time,color=color.new(color.lime,15),style=line.style_dashed,width=1)
        line.new(t(2026,7,17),75.44,t(2027,1,1),75.44,xloc=xloc.bar_time,color=color.new(color.lime,15),style=line.style_dashed,width=1)
        label.new(t(2026,11,1),65.08,"65.08 continuation",xloc=xloc.bar_time,yloc=yloc.price,color=color.red,textcolor=color.white,style=label.style_label_left,size=size.small)
        label.new(t(2026,11,1),69.49,"69.49 first evidence",xloc=xloc.bar_time,yloc=yloc.price,color=color.rgb(0,145,95),textcolor=color.white,style=label.style_label_left,size=size.small)
        label.new(t(2026,11,1),75.44,"75.44 stronger evidence",xloc=xloc.bar_time,yloc=yloc.price,color=color.rgb(0,145,95),textcolor=color.white,style=label.style_label_left,size=size.small)
